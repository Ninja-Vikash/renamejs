{
  "name": "caselyjs",
  "version": "1.0.6",
  "author": "thatonevikash",
  "description": "Powerful CLI to bulk rename files and directories across your codebase with kebab, camel, or Pascal case. Fast, simple, and easy to use.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thatonevikash/caselyjs.git"
  },
  "keywords": [
    "codebase renamer",
    "naming convention tool",
    "file / folder renamer",
    "case changer",
    "kebab case to pascal case",
    "pascal case to camel case",
    "came case to kebab case"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thatonevikash/caselyjs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://github.com/thatonevikash/caselyjs#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "casely": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin.js",
    "dev": "ts-node src/bin.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
